<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.crate_app" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Branded launch screen (dark). @color/splash_background resolves to the night value. -->
        <item name="android:windowBackground">@drawable/launch_splash</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@mipmap/ic_launcher_foreground</item>
    </style>
</resources>
