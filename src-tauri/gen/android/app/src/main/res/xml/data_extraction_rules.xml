<?xml version="1.0" encoding="utf-8"?>
<!-- No cloud backup, no device transfer (API 31+ counterpart of allowBackup="false"): the
     SQLCipher key is wrapped by a non-exportable Android Keystore key (CrateDbKey.kt), so a
     restored/transferred blob could never be decrypted on the destination device — it would
     just brick the database. Cloud sync is the supported migration path. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
