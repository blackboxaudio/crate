<?xml version="1.0" encoding="utf-8"?>
<!-- Preview audio streams from the in-process axum proxy at http://127.0.0.1:<random port>
     (see src-tauri/src/proxy.rs), so cleartext must be allowed for loopback — and only loopback;
     everything else stays HTTPS-only. The debug source set (src/debug/res/xml/) overrides this
     with a permissive config so dev builds can reach the LAN-IP vite dev server. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
